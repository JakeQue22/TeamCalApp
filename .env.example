# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth callback URL (must match Google Cloud Console)
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Session secret (use a random string for production)
SESSION_SECRET=your_session_secret_change_in_production

# Server configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database (SQLite file path)
DATABASE_URL=file:./dev.db

# Frontend URL (used for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Backend API URL (used by Next.js rewrites to proxy API requests)
# In Docker, this should point to the backend service (e.g. http://backend:3001)
NEXT_PUBLIC_API_URL=http://localhost:3001

# CORS allowed origins (comma-separated, overrides FRONTEND_URL for CORS)
# Example: http://localhost:3000,http://0.0.0.0:3000
# CORS_ORIGINS=http://localhost:3000
